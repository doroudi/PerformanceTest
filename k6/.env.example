# Copy this file to k6/.env and fill it in.
#
#   Copy-Item k6\.env.example k6\.env
#
# k6/.env is gitignored - keep it that way, because it holds a password. This file
# (.env.example) is committed and must never contain a real credential.
#
# Format: KEY=value, one per line. Blank lines and lines starting with '#' are ignored.
# A value may be wrapped in single or double quotes, and a leading `export ` is accepted.
#
# Do NOT put a comma in a value: the runner passes these to k6 as a comma-separated list,
# so a comma cannot be represented and the value would be silently truncated.
#
# Precedence, first hit winning:
#   command line  >  this file  >  prompt (account and password only)  >  error

# ---------------------------------------------------------------------------
# The journey test (k6/run-journey.ps1)
# ---------------------------------------------------------------------------
TARGET_URL=https://example.com
LOGIN_URL=https://example.com/accounts/login
JOURNEY_USERNAME=someone@example.com
JOURNEY_PASSWORD=change-me

# Load profile. Override for a single run with -Vus / -Duration on the command line.
TARGET_VUS=5
TEST_DURATION=1m
# STEP_PAUSE=0          # think time between the steps
# REQUEST_PAUSE=0.5     # think time between one journey and the next

# ---------------------------------------------------------------------------
# Optional: the API base, when it must differ from TARGET_URL
# ---------------------------------------------------------------------------
# API_BASE_URL=https://example.com

# ---------------------------------------------------------------------------
# Optional: a standard OAuth2 token endpoint, for k6/scripts/lib/auth.js
# ---------------------------------------------------------------------------
# AUTH_MODE=oauth2
# AUTH_TOKEN_URL=https://idp.example.com/connect/token
# AUTH_CLIENT_ID=my-client
# AUTH_CLIENT_SECRET=change-me
# AUTH_SCOPE=api

# ---------------------------------------------------------------------------
# Optional: a BESPOKE JSON login endpoint (what the journey uses)
#
# With AUTH_MODE=json-login, every test type - not just the journey - logs in with
# LOGIN_URL/JOURNEY_USERNAME/JOURNEY_PASSWORD and renews the token before it expires.
# The journey itself ignores this and logs in once in setup().
#
# AUTH_TOKEN_PATH says where the token sits in the response (dot separated);
# AUTH_LOGIN_BODY can replace the default JSON body, with {{username}} and {{password}}
# substituted, for an endpoint that wants different field names.
# ---------------------------------------------------------------------------
# AUTH_MODE=json-login
# AUTH_TOKEN_PATH=data.accessToken
# AUTH_LOGIN_BODY={"Email":"{{username}}","Password":"{{password}}","RememberMe":true}

# ---------------------------------------------------------------------------
# Optional: extra headers on every request, entries separated by ';;'
# ---------------------------------------------------------------------------
# REQUEST_HEADERS=X-Auth-User: loadtest;;X-Auth-Secret: change-me
