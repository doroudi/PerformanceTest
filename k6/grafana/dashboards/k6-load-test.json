  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Highest number of concurrent virtual users observed in the selected time range. This is the load that was actually offered.",
      "fieldConfig": {
        "defaults": { "decimals": 0, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["max"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(max_over_time(k6_vus{testid=~\"$testid\", test_type=~\"$test_type\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Peak virtual users",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total requests completed. k6_http_reqs_total is a counter, so its last value over the range is the run total.",
      "fieldConfig": {
        "defaults": { "decimals": 0, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["max"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(max_over_time(k6_http_reqs_total{testid=~\"$testid\", test_type=~\"$test_type\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "95th percentile of request duration over the whole selected range. Native histogram when available, otherwise k6's cumulative gauge.",
      "fieldConfig": {
        "defaults": { "decimals": 2, "unit": "ms" },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
