  "description": "Load-test results for a k6 run. Latency panels prefer Prometheus native histograms (true per-interval percentiles) and fall back to k6's gauge trend statistics automatically, so this dashboard works whether or not native histograms are enabled.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
